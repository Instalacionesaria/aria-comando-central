    "db:sembrar": "node --env-file-if-exists=.env.local scripts/db.mjs sembrar",
    "db:verificar": "node --env-file-if-exists=.env.local scripts/db.mjs verificar",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db.mjs reset",
